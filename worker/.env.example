# Local development only. Copy to .dev.vars; never commit real values.
ADMIN_TOKEN=replace-with-a-long-random-token
READ_TOKEN=replace-with-a-different-long-random-token
ENROLLMENT_PEPPER=replace-with-random-pepper
CREDENTIALS_KEY=replace-with-32-random-bytes-encoded-as-base64url
# Optional: Cloudflare frontend for VMess-WS tunnels (see docs/deployment.md).
CLOUDFLARE_API_TOKEN=replace-with-a-zone-scoped-token
CLOUDFLARE_ZONE_NAME=example.com
# Optional: preferred address (e.g. an optimized Cloudflare anycast IP) issued
# as the VMess `add` field for active frontends; host/SNI stay the hostname.
# Accepts a hostname or a public IPv4/IPv6; empty or unset falls back to the hostname.
CLOUDFLARE_PREFERRED_ADDRESS=104.16.132.229
